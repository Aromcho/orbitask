# Copiá este archivo como .env y completá los valores.

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB (el de docker-compose.yml en la raíz del proyecto)
MONGODB_URI=mongodb://orbitask:orbitask@localhost:27017/orbitask?authSource=admin

# Firma de la cookie de sesión. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiame

# Tu usuario: se crea solo la primera vez que arranca la API con la base vacía.
ADMIN_EMAIL=barriosarom@gmail.com
ADMIN_PASSWORD=cambiame123
ADMIN_NAME=Arom

# NestJS Observe (observe.nestjs.com → tu servicio → keys)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Versión que se muestra en Observe (en producción: el SHA del commit)
GIT_SHA=dev
